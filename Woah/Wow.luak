    VerifyStroke.Thickness = 1
    VerifyStroke.Transparency = 0.25
    VerifyStroke.Parent = Verify

    local Status = Instance.new("TextLabel")
    Status.Size = UDim2.new(1, -30, 0, 25)
    Status.Position = UDim2.fromOffset(15, 188)
    Status.BackgroundTransparency = 1
    Status.Text = ""
    Status.TextColor3 = Color3.fromRGB(160, 160, 160)
    Status.TextSize = 12
    Status.Font = Enum.Font.Gotham
    Status.TextXAlignment = Enum.TextXAlignment.Center
    Status.Parent = Main

    GetKey.MouseEnter:Connect(function()
        TweenService:Create(
            GetKey,
            TweenInfo.new(0.15),
            {BackgroundColor3 = Color3.fromRGB(45, 45, 45)}
        ):Play()
    end)

    GetKey.MouseLeave:Connect(function()
        TweenService:Create(
            GetKey,
            TweenInfo.new(0.15),
            {BackgroundColor3 = Color3.fromRGB(35, 35, 35)}
        ):Play()
    end)

    Verify.MouseEnter:Connect(function()
        TweenService:Create(
            Verify,
            TweenInfo.new(0.15),
            {BackgroundColor3 = Color3.fromRGB(155, 155, 5)}
        ):Play()
    end)

    Verify.MouseLeave:Connect(function()
        TweenService:Create(
            Verify,
            TweenInfo.new(0.15),
            {BackgroundColor3 = Color3.fromRGB(134, 134, 2)}
        ):Play()
    end)

    GetKey.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard("dsc.gg/monarchwin")
            Status.Text = "Discord link copied!"
        else
            Status.Text = "Clipboard is unavailable."
        end
    end)

    Verify.MouseButton1Click:Connect(function()
        if Verify.Text == "Checking..." then
            return
        end

        Verify.Text = "Checking..."
        Status.Text = ""

        local enteredKey = Box.Text:gsub("%s+", "")

        if enteredKey == VALID_KEY then
            local success = pcall(function()
                writefile(SAVE_FILE, VALID_KEY)
            end)

            if not success then
                Status.Text = "Could not save key."
                Verify.Text = "Verify Key"
                return
            end

            Status.Text = "Key verified!"
            Verify.Text = "Verified!"

            task.wait(0.4)

            Gui:Destroy()
            nights()
        else
            Status.Text = "Invalid key."
            Verify.Text = "Verify Key"
        end
    end)

    local Dragging = false
    local DragStart
    local StartPos

    Main.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = Input.Position
            StartPos = Main.Position
        end
    end)

    Main.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then
            return
        end

        if Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch then
            local Delta = Input.Position - DragStart

            Main.Position = UDim2.new(
                StartPos.X.Scale,
                StartPos.X.Offset + Delta.X,
                StartPos.Y.Scale,
                StartPos.Y.Offset + Delta.Y
            )
        end
    end)
end

loaded()

    Notice.Font = Enum.Font.Gotham
    Notice.TextWrapped = true
    Notice.TextXAlignment = Enum.TextXAlignment.Left
    Notice.TextYAlignment = Enum.TextYAlignment.Center
    Notice.Parent = Main

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -30, 0, 30)
    Title.Position = UDim2.fromOffset(15, 49)
    Title.BackgroundTransparency = 1
    Title.Text = "Monarch Key System"
    Title.TextColor3 = Color3.new(1, 1, 1)
    Title.TextSize = 20
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Main

    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(1, -30, 0, 42)
    Box.Position = UDim2.fromOffset(15, 84)
    Box.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
